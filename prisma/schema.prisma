generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  username String @unique
  passwordHash String
  coins Int @default(100000)
  xp Int @default(0)
  isBanned Boolean @default(false)
  openSlots Int @default(1)
  starterClaimed Boolean @default(false)
  freeLastOpenedAt DateTime?
  chatLastSentAt DateTime?
  giftLastSentAt DateTime?
  chatMessages ChatMessage[]
  sentGifts GiftTransfer[] @relation("GiftSender")
  receivedGifts GiftTransfer[] @relation("GiftReceiver")
  sentTrades TradeOffer[] @relation("TradeSender")
  receivedTrades TradeOffer[] @relation("TradeReceiver")
  createdAt DateTime @default(now())
  lastSeenAt DateTime?
  lastLoginAt DateTime?
  visitCount Int @default(0)
  sessions Session[]
  inventory InventoryItem[]
  openings Opening[]
}
model Session {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
}
model Case {
  id String @id @default(uuid())
  slug String @unique
  name String
  price Int
  imageUrl String?
  items Item[]
  openings Opening[]
}
model Item {
  id String @id @default(uuid())
  name String
  rarity String
  value Int
  weight Int
  imageUrl String?
  priceOrigin String @default("GAME")
  marketHashName String?
  priceCheckedAt DateTime?
  priceSourceUrl String?
  caseId String
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  inventory InventoryItem[]
}
model InventoryItem {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  itemId String
  item Item @relation(fields: [itemId], references: [id])
  soldAt DateTime?
  valueAtDrop Int?
  isDemo Boolean @default(false)
  battleId String?
  mergedCount Int @default(1)
  tradeLockId String?
  createdAt DateTime @default(now())
  @@index([ownerId, soldAt, isDemo])
  @@index([battleId, ownerId])
  @@index([ownerId, tradeLockId, soldAt])
}
model Opening {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  caseId String
  case Case @relation(fields: [caseId], references: [id])
  itemId String
  boughtAt DateTime @default(now())
  @@index([userId])
}

model Battle {
 rounds BattleRound[]
 totalCost Int @default(0)
 id String @id @default(uuid())
 caseId String
 creatorId String
 guestId String?
 againstBot Boolean @default(false)
 duo Boolean @default(false)
 duoBotSeats String[] @default([])
 creatorPartnerId String?
 guestPartnerId String?
 status String @default("WAITING")
 winnerId String?
 creatorItemId String?
 guestItemId String?
 creatorPartnerItemId String?
 guestPartnerItemId String?
 creatorPartnerValue Int?
 guestPartnerValue Int?
 creatorValue Int?
 guestValue Int?
 createdAt DateTime @default(now())
 finishedAt DateTime?
 @@index([status,createdAt])
 @@index([creatorId,status])
 @@index([guestId])
}

model BattleRound {
 id String @id @default(uuid())
 battleId String
 battle Battle @relation(fields:[battleId],references:[id],onDelete:Cascade)
 position Int
 caseId String
 casePrice Int
 creatorItemId String?
 guestItemId String?
 creatorPartnerItemId String?
 guestPartnerItemId String?
 creatorPartnerValue Int?
 guestPartnerValue Int?
 creatorValue Int?
 guestValue Int?
 @@unique([battleId,position])
 @@index([caseId])
}

model ChatMessage {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  body String @db.VarChar(280)
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([userId,createdAt])
}

model GiftTransfer {
  id String @id @default(uuid())
  senderId String
  sender User @relation("GiftSender",fields:[senderId],references:[id])
  recipientId String
  recipient User @relation("GiftReceiver",fields:[recipientId],references:[id])
  amount Int
  createdAt DateTime @default(now())
  @@index([senderId,createdAt])
  @@index([recipientId,createdAt])
}

model RareDropEvent {
  id String @id @default(uuid())
  username String
  itemName String
  rarity String
  value Int
  imageUrl String?
  source String
  inventoryItemId String @unique
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model TradeOffer {
  id String @id @default(uuid())
  senderId String
  sender User @relation("TradeSender",fields:[senderId],references:[id])
  recipientId String
  recipient User @relation("TradeReceiver",fields:[recipientId],references:[id])
  offeredIds String[]
  requestedIds String[]
  status String @default("PENDING")
  createdAt DateTime @default(now())
  finishedAt DateTime?
  @@index([senderId,status,createdAt])
  @@index([recipientId,status,createdAt])
}

model AdminAuditLog {
 id String @id @default(uuid())
 actorId String
 actorUsername String
 action String
 targetType String
 targetId String
 details String @default("{}")
 createdAt DateTime @default(now())
 @@index([createdAt])
 @@index([actorId,createdAt])
 @@index([targetType,targetId,createdAt])
}

model AdminCaseOverride {
 slug String @id
 price Int
 updatedAt DateTime @updatedAt
}
model AdminItemOverride {
 itemId String @id
 weight Int
 updatedAt DateTime @updatedAt
}

model GameEvent {
  id String @id
  discountPercent Int @default(0)
  luckMultiplier Int @default(100)
  startsAt DateTime
  endsAt DateTime
  createdById String
  updatedAt DateTime @updatedAt
}

model AdminAnnouncement {
 id String @id @default(uuid())
 message String @db.VarChar(500)
 createdAt DateTime @default(now())
 expiresAt DateTime
 createdById String
 @@index([expiresAt,createdAt])
}

model UserAccessLog {
 id String @id @default(uuid())
 userId String
 activity String @db.VarChar(32)
 createdAt DateTime @default(now())
 @@index([userId,createdAt])
}

model WatchlistEntry {
 userId String @id
 reason String @db.VarChar(500)
 createdAt DateTime @default(now())
 createdBy String
 lastCheckedAt DateTime?
 lastBalance Int?
 lastOpeningCount Int?
 @@index([createdAt])
}

model WatchAlert {
 id String @id @default(uuid())
 userId String
 category String @db.VarChar(48)
 description String @db.VarChar(500)
 details String @default("{}")
 createdAt DateTime @default(now())
 resolvedAt DateTime?
 @@index([userId,createdAt])
 @@index([resolvedAt,createdAt])
}

model WatchActivity {
 id String @id @default(uuid())
 userId String
 kind String @db.VarChar(48)
 details String @default("{}")
 createdAt DateTime @default(now())
 @@index([userId,createdAt])
}

model PlayerWarning {
 id String @id @default(uuid())
 userId String
 reason String @db.VarChar(500)
 createdBy String
 createdAt DateTime @default(now())
 @@index([userId,createdAt])
}
